{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/*)",
      "Bash(python3 -m unittest discover tools/tests*)",
      "Bash(npm run check)",
      "Bash(npm run site:data)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(curl -s https://api.fxtwitter.com/*)",
      "WebFetch(domain:hacked.slowmist.io)",
      "WebFetch(domain:www.rektradar.xyz)",
      "WebFetch(domain:api.fxtwitter.com)",
      "WebFetch(domain:eth.blockscout.com)",
      "WebFetch(domain:mempool.space)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-example.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
